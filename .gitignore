# Build artifacts
workbench/src-tauri/target/
workbench/node_modules/
workbench/dist/

# Environment & Secrets
.env
.token_cache.json

# Python
venv/
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
Thumbs.db

# Logs
logs/*.log
logs/*.json

# App bundle (built artifact)
workbench/BFD.app/

# Built launcher bundle (setup.sh regenerates it)
BFD.app/

# Staged-swap artifacts
*.bak
nohup.out

# Jupyter noise
.ipynb_checkpoints/

# Gitter (BFD_GITTER) plumbing — only run.sh and the plist copy are versioned;
# the stage clone, logs, sync marker and fail counter must never enter this repo
# (a tracked marker would dirty the tree on every sync and loop the checkpointer)
.bfd/gitter/*
!.bfd/gitter/run.sh
!.bfd/gitter/com.turing.bfd-gitter.plist
